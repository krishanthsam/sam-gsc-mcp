# Sam GSC MCP — environment variables (copy the ones you need into your MCP client's "env" block).
# Paths must be ABSOLUTE. Never commit real credential files.

# --- Authentication (pick one) -------------------------------------------
# OAuth with your own Google account (recommended for individuals):
GSC_OAUTH_CLIENT_SECRETS_FILE=/Users/you/secure/client_secrets.json
# Service account key (automation / teams). GOOGLE_APPLICATION_CREDENTIALS also works:
# GSC_CREDENTIALS_PATH=/Users/you/secure/service_account.json
# auto (OAuth -> service account -> ADC) | oauth | service_account | adc
# GSC_AUTH_MODE=auto
# GSC_SKIP_OAUTH=false
# GSC_USE_ADC=false

# --- Defaults ------------------------------------------------------------
# Property used when a tool is called without site_url:
# GSC_SITE_URL=sc-domain:example.com
# all = matches the dashboard (default) | final = confirmed data only (2-3 day lag)
# GSC_DATA_STATE=all

# --- Safety --------------------------------------------------------------
# GSC_READ_ONLY=false          # true = read-only scope, hides every write tool
# GSC_ALLOW_DESTRUCTIVE=false  # true = enable add_site, delete_site, delete_sitemap, URL_DELETED
# GSC_ENABLE_INDEXING_API=false

# --- Tool selection (handy for clients with tool limits, e.g. Cursor) ------
# GSC_TOOLSETS=all   # or e.g. setup,properties,analytics,insights,inspection,sitemaps
# GSC_DISABLED_TOOLS=add_site,delete_site
# GSC_COMPAT_ALIASES=false   # true = also expose list_sites, get_performance_data, submit_url ...

# --- Limits & tuning -----------------------------------------------------
# GSC_MAX_BATCH_URLS=10
# GSC_INSPECTION_CONCURRENCY=10
# GSC_API_RETRIES=3
# GSC_OAUTH_PORT=0
# GSC_OAUTH_TIMEOUT=300
# GSC_UPDATE_CHECK=true
# GSC_LOG_LEVEL=WARNING

# --- Files ---------------------------------------------------------------
# GSC_CONFIG_DIR=          # token.json + config.json location (default: OS user config dir)
# GSC_TOKEN_FILE=
# GSC_EXPORT_DIR=          # CSV exports (default: ~/Documents/sam-gsc-exports)

# --- Transport (remote use only) -----------------------------------------
# MCP_TRANSPORT=stdio      # stdio | sse | streamable-http
# MCP_HOST=127.0.0.1
# MCP_PORT=3001
# MCP_PATH=/mcp
